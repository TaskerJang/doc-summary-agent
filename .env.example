# =============================================================================
# doc-summary-agent — 환경 변수 템플릿
# =============================================================================
# 실제 사용 시 .env 파일을 만들고 아래 값을 본인 키로 교체하세요.
# .env 파일은 .gitignore에 포함되어 있어 commit되지 않습니다.

# -----------------------------------------------------------------------------
# OpenAI (선택 또는 필수)
# -----------------------------------------------------------------------------
# 본 prod (Chainlit UI) 의 기본 LLM. 평가 시 인자 미지정이면 측정/judge 둘 다 이 키 사용.
# 평가에서 측정/judge 모두 OpenRouter 경유로 토글하면 (#127) 본 키 없이도 가능.
#
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# OpenRouter (#127 평가 LLM 토글, 선택)
# -----------------------------------------------------------------------------
# 평가 진입점 (eval/run_eval.py) 에서 --llm-* / --judge-* 인자로 모델 토글 시 사용.
# Chainlit UI (prod) 는 이 키 사용 안 함.
#
# 본 키 1개로 측정 + judge 둘 다 OpenRouter 경유 가능 → OPENAI_API_KEY 없이도 평가 가능.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 측정 대상 모델 ID 참고 (실제 사용은 --llm-model 인자로 전달):
#   openai/gpt-5-mini          $0.25 / $2.00 per 1M tokens, 400K context
#   deepseek/deepseek-v3.2     $0.252 / $0.378 per 1M tokens, 131K context
#   moonshotai/kimi-k2.5       $0.40 / $1.90 per 1M tokens, 262K context
#   x-ai/grok-4.20             $1.25 / $2.50 per 1M tokens, 2M context
#
# Judge 모델 ID 참고 (실제 사용은 --judge-model 인자로 전달):
#   anthropic/claude-haiku-4.5 $1.00 / $5.00 per 1M tokens, 200K context  (추천)
#   anthropic/claude-sonnet-4.5 $3.00 / $15.00 per 1M tokens, 1M context  (고정밀)
#   openai/gpt-5-mini          $0.25 / $2.00 per 1M tokens                (저렴)
#
# 사용 예 (측정 + judge 모두 OpenRouter, OPENROUTER_API_KEY 만 필요):
#   uv run python eval/run_eval.py \
#     --llm-model "moonshotai/kimi-k2.5" \
#     --llm-base-url "https://openrouter.ai/api/v1" \
#     --llm-api-key-env "OPENROUTER_API_KEY" \
#     --judge-model "anthropic/claude-haiku-4.5" \
#     --judge-base-url "https://openrouter.ai/api/v1" \
#     --judge-api-key-env "OPENROUTER_API_KEY" \
#     --tag "kimi_k2_5"

# -----------------------------------------------------------------------------
# Qdrant (벡터 DB, 선택)
# -----------------------------------------------------------------------------
# Dense 검색 (BM25 + Dense + RRF + Reranker 풀 하이브리드) 사용 시 필요.
# Qdrant 미연결 또는 환경변수 미설정 시 BM25 자동 fallback (#127).
#
# 옵션 A — 로컬 도커 (기본):
#   docker run -d --name qdrant -p 6333:6333 qdrant/qdrant
#   → QDRANT_URL=http://localhost:6333 (기본값, 명시 불필요)
#   → QDRANT_API_KEY 미설정 (인증 없음)
#
# 옵션 B — Qdrant Cloud (도커 미설치 환경):
#   https://cloud.qdrant.io 에서 free tier (1GB) 클러스터 생성
#   클러스터 생성 후 URL + API key 발급 → 아래 두 변수 설정
QDRANT_URL=http://localhost:6333
# QDRANT_URL=https://xxxxxxxx-xxxx-xxxx.xxx.cloud.qdrant.io:6333   # Cloud 예시
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here                     # Cloud 사용 시 필수

# -----------------------------------------------------------------------------
# 청크 저장소 디렉토리 (선택)
# -----------------------------------------------------------------------------
# Chainlit 세션 resume 시 사용할 청크 JSON 저장 경로 (PR #125 참조).
# 미설정 시 기본값: /tmp/doc-summary-agent/chunks/
# CHUNKS_STORAGE_DIR=/tmp/doc-summary-agent/chunks/
