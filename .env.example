# =============================================================================
# doc-summary-agent — 환경 변수 템플릿
# =============================================================================
# 실제 사용 시 .env 파일을 만들고 아래 값을 본인 키로 교체하세요.
# .env 파일은 .gitignore에 포함되어 있어 commit되지 않습니다.

# -----------------------------------------------------------------------------
# OpenAI (필수) — 본 prod (Chainlit UI) 의 기본 LLM
# -----------------------------------------------------------------------------
# Map-Reduce 요약 (summarizer/llm.py), Q&A 및 추천 질문 (summarizer/qa.py),
# Faithfulness/Numerical judge (eval/metrics/faithfulness_judge.py) 에 사용.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# OpenRouter (#127 평가 LLM 토글, 선택)
# -----------------------------------------------------------------------------
# 평가 진입점 (eval/run_eval.py) 에서 --llm-* 인자로 모델 토글 시 필요.
# Chainlit UI (prod) 는 이 키 사용 안 함 — OPENAI_API_KEY 그대로 동작.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 측정 대상 모델 ID 참고 (실제 사용은 --llm-model 인자로 전달):
#   openai/gpt-5-mini          $0.25 / $2.00 per 1M tokens, 400K context
#   deepseek/deepseek-v3.2     $0.252 / $0.378 per 1M tokens, 131K context
#   moonshotai/kimi-k2.5       $0.40 / $1.90 per 1M tokens, 262K context
#   x-ai/grok-4.20             $1.25 / $2.50 per 1M tokens, 2M context
#
# 사용 예:
#   uv run python eval/run_eval.py \
#     --llm-model "moonshotai/kimi-k2.5" \
#     --llm-base-url "https://openrouter.ai/api/v1" \
#     --llm-api-key-env "OPENROUTER_API_KEY" \
#     --tag "kimi_k2_5_openrouter"

# -----------------------------------------------------------------------------
# 청크 저장소 디렉토리 (선택)
# -----------------------------------------------------------------------------
# Chainlit 세션 resume 시 사용할 청크 JSON 저장 경로 (PR #125 참조).
# 미설정 시 기본값: /tmp/doc-summary-agent/chunks/
# CHUNKS_STORAGE_DIR=/tmp/doc-summary-agent/chunks/
